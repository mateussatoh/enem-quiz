# Postgres (docker compose sobe na porta 5433)
DATABASE_URL=postgres://quiz:quiz@localhost:5433/quiz
# Banco isolado para os testes de integração da API
TEST_DATABASE_URL=postgres://quiz:quiz@localhost:5433/quiz_test
# Segredo para assinar o cookie de sessão do admin (mínimo 32 caracteres)
SESSION_SECRET=troque-este-segredo-por-um-valor-aleatorio-de-32+
# Leads novos por IP a cada 10 min (padrão 20 no deploy; local fica alto para testar à vontade)
SUBMISSION_RATE_LIMIT=100
# Confiar em x-forwarded-for só atrás de um proxy que o define (na Vercel é automático)
TRUST_PROXY=false
# Credenciais do admin criadas pelo seed
ADMIN_EMAIL=admin@assaad.dev
ADMIN_PASSWORD=Assaad@2026

# Opcionais. Sem elas o app funciona normalmente, só não envia o e-mail.
# Resend: e-mail com o diagnóstico para o lead (o remetente de teste só entrega para o dono da conta)
RESEND_API_KEY=
EMAIL_FROM=Diagnóstico ENEM <onboarding@resend.dev>
# URL pública usada nos links do e-mail (padrão: origem da requisição)
APP_URL=
